# ChipForge EDA server settings (npu-v2), read by docker compose.
#   cp .env.example .env    (empty = automatic / built-in default)
# Apply a change with: docker compose up -d

# =====================================================================================
# Network (security)
# =====================================================================================
# Interface the gateway's port 8080 is published on. /v2/evaluate runs evaluator code, so keep the
# default 127.0.0.1 when the validator runs on this machine. Use 0.0.0.0 only if another machine
# must reach it, and then firewall port 8080 to that machine's IP (never open it to the internet).
EDA_BIND_ADDRESS=127.0.0.1

# =====================================================================================
# v2 evaluator
# =====================================================================================
# /v2/* returns 503 while the evaluator is unreachable.
V2_SERVICE_URL=http://v2-evaluator:18080
# If set, POST /v2/evaluator (optional pre-warm) requires "Authorization: Bearer <token>".
V2_ADMIN_TOKEN=
# Anything passed as a sibling Docker bind mount must use the same host/container path.
CF_V2_ROOT=/var/lib/chipforge-v2
# Host directory mounted only at /run/cf-secrets inside the evaluator.
CF_V2_SECRETS=/var/lib/chipforge-v2-secrets
# Resources. Empty = auto (every CPU the container may use; its RAM less max(4 GiB, 12.5%)).
# CF_CPUS: auto | a count of logical CPUs (16) | a percentage (75%). CF_MEMORY: auto | 160GiB | 75%.
# The same knobs (and the "waits" hang-detection knobs) can live in the evaluator config file,
# $CF_V2_ROOT/evaluator.json by default, or the in-container path in CF_EVALUATOR_CONFIG:
#   {"resources": {"cpus": 32, "memory": "160GiB"}, "waits": {"step_bound_factor": 8}}
# Environment beats the file. Other sections (e.g. "simulation") follow the installed evaluator;
# the loader runs that evaluator's own config check at start-up and refuses a file it rejects.
CF_CPUS=
CF_MEMORY=
CF_EVALUATOR_CONFIG=
# Deprecated: CF_V2_CORES, a COUNT of CPUs used only when nothing above sets cpus. To pin the
# evaluator to specific CPUs use a compose override (`cpuset: "16-31"`; see README).
# One coordinator worker by default.
CF_V2_CORES=
CF_V2_WORKERS=1
CF_V2_ALLOWED_MODES=T2
# ChipForge's evaluator publisher key (OpenSSH Ed25519). The EDA server installs only evaluator zips signed
# with the matching private key and refuses every other zip.
CF_V2_EVALUATOR_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIVkNtpVGvg0KdjfsaAwSPn2ztpVBupq8pFIRKDEFOdG chipforge-evaluator
# 0 = install signed evaluators only. Both settings below are recorded in every response.
CF_V2_ALLOW_UNSIGNED=0
# Container runtime for miner code: 1 = Docker's standard runtime (runc), the Quest 2 launch setting; miner code
# runs with no network either way. 0 = require gVisor (runsc).
CF_V2_ALLOW_RUNC=1
# Free space the evaluator's preflight requires under CF_V2_ROOT. Empty = the evaluator's own
# minimum (100 GiB for v2.0). Lower only on a testnet/development host; reported in /v2/health.
CF_V2_PREFLIGHT_MIN_DISK_GIB=
CF_V2_SERVICE_MEMORY_MAX=5G
# Gate B public-pool cache (read-write; empty = $CF_V2_ROOT/gateb-pool-cache) and optional
# read-only mirror (pre-seeded <sha[:2]>/<sha> files; empty = /var/lib/chipforge-v2-gateb-mirror,
# created empty). Images are ~250 KB each; budget a few GB for the cache.
CF_GATEB_CACHE=
CF_GATEB_MIRROR=
# drand relays for T1/T2 randomness, comma separated https:// base URLs. Empty = the signed beacon
# policy's defaults (api.drand.sh, api2.drand.sh, api3.drand.sh, drand.cloudflare.com).
CF_DRAND_RELAYS=
CF_DRAND_TIMEOUT_S=
CF_DRAND_DEADLINE_S=
