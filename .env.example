# ChipForge EDA server settings, read by docker compose (make up / make start).
#   cp .env.example .env    (every value is optional; empty = automatic / built-in default)
# Restart after a change: docker compose up -d

# =====================================================================================
# Network (security)
# =====================================================================================
# Interface the gateway's port 8080 is published on. /evaluate runs code from the uploaded
# evaluator ZIP and has no API key, so keep the default 127.0.0.1 when the validator runs on this
# machine. Use 0.0.0.0 only if another machine must reach it, and then firewall port 8080 to that
# machine's IP (never open it to the internet).
EDA_BIND_ADDRESS=127.0.0.1

# =====================================================================================
# Time limits (seconds)
# =====================================================================================
# The time an evaluation may run is set by the challenge server's batch deadline: the validator sends it
# with every request (time_limit_s) and each service runs for what is left of it after its queue.
# Run-time limit for a request WITHOUT a budget (a validator older than that), counted after the queue
EVAL_TIMEOUT_S=2700
# Gateway ceiling on queue + run. Keep it above the batch evaluation window: a budget longer than this
# is cut to it, and a run stopped by it is a system fault (retryable), never the miner's
EDA_REQUEST_TIMEOUT_S=14400

# =====================================================================================
# Capacity (empty = sized automatically from this machine's CPU cores and memory)
# =====================================================================================
# Parallel synthesis (OpenLane) runs
OPENLANE_LANES=
# Memory reserved per synthesis run (MB)
OPENLANE_MEM_PER_RUN_MB=
# Simulation CPU slots, parallel simulations, and slots per simulation
VERILATOR_SIM_SLOTS=
VERILATOR_EVAL_LANES=
VERILATOR_FANOUT=
# Reuse synthesis results for identical designs (1 = on, 0 = off) and how many to keep
OPENLANE_SYNTH_CACHE=1
OPENLANE_SYNTH_CACHE_KEEP=500

# =====================================================================================
# Upload limits (MB)
# =====================================================================================
C15_MAX_SUBMISSION_MB=300
C15_MAX_UNCOMPRESSED_MB=4096

# =====================================================================================
# Testing only
# =====================================================================================
# Path inside the gateway container to a mock result JSON (e.g. /shared/eda_mock.json): when set,
# /evaluate skips Verilator and OpenLane and returns that result. Never set it in production.
EDA_MOCK_FILE=
