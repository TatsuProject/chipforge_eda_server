# ChipForge EDA server settings, read by docker compose (make up / make start).
#   cp .env.example .env    (every value is optional; empty = automatic / built-in default)
# Restart after a change: docker compose up -d

# =====================================================================================
# Network (security)
# =====================================================================================
# Interface the gateway's port 8080 is published on. /evaluate runs code from the uploaded
# evaluator ZIP and has no API key, so keep the default 127.0.0.1 when the validator runs on this
# machine. Use 0.0.0.0 only if another machine must reach it, and then firewall port 8080 to that
# machine's IP (never open it to the internet).
EDA_BIND_ADDRESS=127.0.0.1

# =====================================================================================
# Time limits (seconds)
# =====================================================================================
# Run-time limit per evaluation, counted after it leaves the queue (exceeding it is the miner's fault)
EVAL_TIMEOUT_S=2700
# Gateway ceiling on queue + run; only a backstop for a long queue (a system fault, retryable)
EDA_REQUEST_TIMEOUT_S=14400

# =====================================================================================
# Capacity (empty = sized automatically from this machine's CPU cores and memory)
# =====================================================================================
# Parallel synthesis (OpenLane) runs
OPENLANE_LANES=
# Memory reserved per synthesis run (MB)
OPENLANE_MEM_PER_RUN_MB=
# Simulation CPU slots, parallel simulations, and slots per simulation
VERILATOR_SIM_SLOTS=
VERILATOR_EVAL_LANES=
VERILATOR_FANOUT=
# Reuse synthesis results for identical designs (1 = on, 0 = off) and how many to keep
OPENLANE_SYNTH_CACHE=1
OPENLANE_SYNTH_CACHE_KEEP=500

# =====================================================================================
# Upload limits (MB)
# =====================================================================================
C15_MAX_SUBMISSION_MB=300
C15_MAX_UNCOMPRESSED_MB=4096

# =====================================================================================
# Testing only
# =====================================================================================
# Path inside the gateway container to a mock result JSON (e.g. /shared/eda_mock.json): when set,
# /evaluate skips Verilator and OpenLane and returns that result. Never set it in production.
EDA_MOCK_FILE=

# =====================================================================================
# v2 evaluator (optional)
# =====================================================================================
# Start v2 with: docker compose --profile v2 up -d --build
# Without the profile, /v2/* returns 503 when the evaluator is unreachable.
V2_SERVICE_URL=http://v2-evaluator:18080
# If set, POST /v2/evaluator (optional pre-warm) requires "Authorization: Bearer <token>".
V2_ADMIN_TOKEN=
# Anything passed as a sibling Docker bind mount must use the same host/container path.
CF_V2_ROOT=/var/lib/chipforge-v2
# Host directory mounted only at /run/cf-secrets inside the evaluator.
CF_V2_SECRETS=/var/lib/chipforge-v2-secrets
# Empty cores = loader derives affinity. One coordinator worker by default.
CF_V2_CORES=
CF_V2_WORKERS=1
CF_V2_ALLOWED_MODES=T2
# Trusted evaluator publisher's OpenSSH Ed25519 public key (ssh-ed25519 AAAA...).
CF_V2_EVALUATOR_PUBLIC_KEY=
# Explicit testnet overrides, recorded in HTTP headers; signatures fail closed by default.
CF_V2_ALLOW_UNSIGNED=0
CF_V2_ALLOW_RUNC=0
# Free space the evaluator's preflight requires under CF_V2_ROOT. Empty = the evaluator's own
# minimum (100 GiB for v2.0). Lower only on a testnet/development host; reported in /v2/health.
CF_V2_PREFLIGHT_MIN_DISK_GIB=
CF_V2_SERVICE_MEMORY_MAX=5G
